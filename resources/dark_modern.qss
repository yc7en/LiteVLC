/* 全局暗色调现代播放器样式表 */

QWidget {
    background-color: #121212;
    color: #E0E0E0;
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* 顶部菜单栏 */
QMenuBar {
    background-color: #181818;
    color: #CCCCCC;
    border-bottom: 1px solid #282828;
    padding: 2px 6px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2D2D2D;
    color: #FFFFFF;
}

/* 下拉菜单 */
QMenu {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #333333;
    padding: 4px;
    border-radius: 6px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #2E2E2E;
    margin: 4px 6px;
}

/* 底部控制栏容器 */
#controlBarContainer {
    background-color: #181818;
    border-top: 1px solid #242424;
}

/* 控制按钮美化 */
QPushButton {
    background-color: #242424;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 5px;
    padding: 5px 12px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #323232;
    border-color: #4A4A4A;
}

QPushButton:pressed {
    background-color: #1A1A1A;
    border-color: #0078D4;
}

QPushButton:checked {
    background-color: #0078D4;
    border-color: #0078D4;
    color: #FFFFFF;
}

/* 主播放按钮高亮 */
#btnPlayPause {
    background-color: #0078D4;
    border-color: #0078D4;
    font-weight: bold;
    padding: 6px 16px;
}

#btnPlayPause:hover {
    background-color: #1984D8;
    border-color: #1984D8;
}

#btnPlayPause:pressed {
    background-color: #006CBE;
}

/* 图标按钮无文字时的紧凑尺寸 */
QPushButton#btnStop, QPushButton#btnPrev, QPushButton#btnNext, QPushButton#btnMute, QPushButton#btnFullscreen {
    padding: 5px 8px;
}

/* 下拉列表 (ComboBox) */
QComboBox {
    background-color: #242424;
    color: #E0E0E0;
    border: 1px solid #333333;
    border-radius: 5px;
    padding: 4px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #4A4A4A;
    background-color: #2A2A2A;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #333333;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

/* 进度条美化 (极简发光流线) */
QSlider::groove:horizontal {
    height: 4px;
    background: #333333;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0078D4;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #0078D4;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #0078D4;
    border: 2px solid #FFFFFF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* 时间标签 */
#timeLabel {
    color: #AAAAAA;
    font-size: 12px;
    font-family: "Consolas", monospace;
    font-weight: 500;
}

/* 右侧播放列表 */
QListWidget {
    background-color: #161616;
    border-left: 1px solid #242424;
    border-top: none;
    border-right: none;
    border-bottom: none;
    color: #CCCCCC;
    outline: none;
}

QListWidget::item {
    height: 32px;
    padding-left: 8px;
    border-radius: 4px;
    margin: 1px 4px;
}

QListWidget::item:hover {
    background-color: #222222;
    color: #FFFFFF;
}

QListWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

/* 滚动条美化 */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #383838;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 设置对话框 */
QDialog {
    background-color: #1A1A1A;
}

QGroupBox {
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: bold;
    color: #0078D4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
}

QSpinBox {
    background-color: #242424;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
}

QCheckBox {
    color: #E0E0E0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #444444;
    border-radius: 3px;
    background-color: #242424;
}

QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
}

/* ===================== 在线片源对话框 ===================== */
QTabWidget::pane {
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: #1E1E1E;
    color: #AAAAAA;
    border: 1px solid #2E2E2E;
    border-bottom: none;
    padding: 6px 18px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: #242424;
    color: #FFFFFF;
}

QTabBar::tab:hover {
    color: #FFFFFF;
}

QLineEdit {
    background-color: #242424;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 5px;
    padding: 5px 10px;
    selection-background-color: #0078D4;
}

QLineEdit:focus {
    border-color: #0078D4;
}

QTableWidget {
    background-color: #161616;
    border: 1px solid #242424;
    border-radius: 6px;
    color: #E0E0E0;
    gridline-color: #242424;
    outline: none;
}

QTableWidget::item {
    padding: 4px 6px;
}

QTableWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #1E1E1E;
    color: #AAAAAA;
    border: none;
    border-right: 1px solid #2A2A2A;
    border-bottom: 1px solid #2A2A2A;
    padding: 6px 8px;
    font-weight: 500;
}

QTextBrowser {
    background-color: #161616;
    border: 1px solid #242424;
    border-radius: 6px;
    color: #CCCCCC;
    padding: 6px;
}

#sourceStatusLabel {
    color: #8AB4F8;
}

#sourceDetailTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
}

#sourceDetailMeta {
    color: #999999;
    font-size: 12px;
}

#sourceHintLabel {
    color: #999999;
}

#btnPlayEpisode {
    background-color: #0078D4;
    border-color: #0078D4;
    font-weight: bold;
    padding: 8px 16px;
}

#btnPlayEpisode:hover {
    background-color: #1984D8;
    border-color: #1984D8;
}

#btnPlayEpisode:disabled {
    background-color: #2A2A2A;
    border-color: #333333;
    color: #666666;
}
