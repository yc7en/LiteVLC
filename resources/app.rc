// Windows 资源脚本：exe 图标 + 版本信息
// 注意：
//  1) windres 不保证非 ASCII 输入编码，这里全部用 ASCII 文本；
//  2) 图标必须写相对文件名，由构建系统用 -I 指向 resources 目录。
//     写死绝对路径（如 E:/02Code/player/...）会导致 CI 或换目录后 windres 直接失败。
IDI_ICON1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,1,5,0
PRODUCTVERSION 1,1,5,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "LiteVLC Team"
            VALUE "FileDescription", "LiteVLC Player"
            VALUE "FileVersion", "1.1.5"
            VALUE "LegalCopyright", "LiteVLC Team"
            VALUE "OriginalFilename", "LiteVlcPlayer.exe"
            VALUE "ProductName", "LiteVLC Player"
            VALUE "ProductVersion", "1.1.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
